diff --git a/init/main.c b/init/main.c
index 7aecf6cace271..dd81b2fd4a0af 100644
--- a/init/main.c
+++ b/init/main.c
@@ -936,6 +936,35 @@ asmlinkage __visible void __init __no_sanitize_address start_kernel(void)
 	pr_notice("%s", linux_banner);
 	early_security_init();
 	setup_arch(&command_line);
+
+	{
+		const char *blacklist[] = {
+			"kasan=off",
+			"cpufreq.default_governor=performance",
+			"rcu_nocbs=",
+			"loglevel=",
+			"log_buf_len=",
+			"console=",
+			"earlycon=",
+			"msm_rtb.filter=",
+			"ftrace_dump_on_oops",
+			"disable_dma32=on",
+			"sched_util_clamp_min_rt_default=640"
+		};
+		int i;
+
+		for (i = 0; i < (int)ARRAY_SIZE(blacklist); i++) {
+			char *p = boot_command_line;
+			while ((p = strstr(p, blacklist[i])) != NULL) {
+				char *end = strchr(p, ' ');
+				size_t len = end ? (size_t)(end - p) : strlen(p);
+
+				memset(p, ' ', len);
+				p += len;
+			}
+		}
+	}
+
 	setup_boot_config();
 	setup_command_line(command_line);
 	setup_nr_cpu_ids();
