diff --git a/kernel/time/timer.c b/kernel/time/timer.c
index f308726cb..ce95fb9c1 100644
--- a/kernel/time/timer.c
+++ b/kernel/time/timer.c
@@ -1798,13 +1798,17 @@ static void run_local_timers(void)
 	struct timer_base *base = this_cpu_ptr(&timer_bases[BASE_STD]);
 
 	hrtimer_run_queues();
-	/* Raise the softirq only if required. */
-	if (time_before(jiffies, base->next_expiry)) {
+	/*
+	 * Raise the softirq only if timers are actually pending and expired.
+	 * Avoids spurious timer softirqs on idle or lightly loaded CPUs,
+	 * extending deep C-state sleep intervals during screen-off idle.
+	 */
+	if (!READ_ONCE(base->timers_pending) || time_before(jiffies, base->next_expiry)) {
 		if (!IS_ENABLED(CONFIG_NO_HZ_COMMON))
 			return;
 		/* CPU is awake, so check the deferrable base. */
 		base++;
-		if (time_before(jiffies, base->next_expiry))
+		if (!READ_ONCE(base->timers_pending) || time_before(jiffies, base->next_expiry))
 			return;
 	}
 	raise_softirq(TIMER_SOFTIRQ);
