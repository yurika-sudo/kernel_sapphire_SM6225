diff --git a/mm/compaction.c b/mm/compaction.c
index 79894f53c..42562f641 100644
--- a/mm/compaction.c
+++ b/mm/compaction.c
@@ -1296,15 +1296,24 @@ static bool suitable_migration_source(struct compact_control *cc,
 	if (pageblock_skip_persistent(page))
 		return false;
 
-	if ((cc->mode != MIGRATE_ASYNC) || !cc->direct_compaction)
+	if (cc->ignore_block_suitable)
 		return true;
 
 	block_mt = get_pageblock_migratetype(page);
 
-	if (cc->migratetype == MIGRATE_MOVABLE)
-		return is_migrate_movable(block_mt);
-	else
-		return block_mt == cc->migratetype;
+	/*
+	 * Fast-skip pageblocks that cannot be migrated. Scanning unmovable
+	 * blocks during compaction for movable allocations wastes CPU cycles
+	 * on slab and kernel pages, causing micro-stutters under memory pressure.
+	 */
+	if (cc->migratetype == MIGRATE_MOVABLE) {
+		if (!is_migrate_movable(block_mt))
+			return false;
+	} else if (block_mt != cc->migratetype) {
+		return false;
+	}
+
+	return true;
 }
 
 /* Returns true if the page is within a block suitable for migration to */
