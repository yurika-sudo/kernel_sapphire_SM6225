diff --git a/drivers/cpuidle/cpuidle.c b/drivers/cpuidle/cpuidle.c
index b0ff03cfe..7bc58273b 100644
--- a/drivers/cpuidle/cpuidle.c
+++ b/drivers/cpuidle/cpuidle.c
@@ -428,6 +428,13 @@ u64 cpuidle_poll_time(struct cpuidle_driver *drv,
 		break;
 	}
 
+	/*
+	 * BACKPORT (v6.12): Cap idle polling to 50us to avoid busy-spinning
+	 * and accelerate entry into deep low-power C-states (WFI/power-collapse).
+	 */
+	if (limit_ns > 50000ULL)
+		limit_ns = 50000ULL;
+
 	dev->poll_limit_ns = limit_ns;
 
 	return dev->poll_limit_ns;
