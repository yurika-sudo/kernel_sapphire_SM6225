diff --git a/drivers/cpuidle/governors/nap/nap.c b/drivers/cpuidle/governors/nap/nap.c
index efda741af..d448b0011 100644
--- a/drivers/cpuidle/governors/nap/nap.c
+++ b/drivers/cpuidle/governors/nap/nap.c
@@ -229,6 +229,15 @@ static int nap_select(struct cpuidle_driver *drv,
 			d->stats.fpu_path_count++;
 		}
 	} else {
+		if (in_hardirq())
+			d->stats.simd_hardirq_count++;
+		if (irqs_disabled())
+			d->stats.simd_irqsoff_count++;
+		if (in_nmi())
+			d->stats.simd_nmi_count++;
+		if (this_cpu_read(fpsimd_context_busy))
+			d->stats.simd_busy_count++;
+
 		idx = nap_fallback_heuristic(drv, dev);
 		d->stats.fallback_count++;
 	}
@@ -341,6 +350,7 @@ static ssize_t stats_show(struct kobject *kobj,
 	int cpu, len = 0;
 	u64 total_sel = 0, total_res = 0, total_under = 0, total_learn = 0;
 	u64 total_sc = 0, total_fpu = 0, total_fb = 0;
+	u64 total_hardirq = 0, total_irqsoff = 0, total_nmi = 0, total_busy = 0;
 
 	for_each_online_cpu(cpu) {
 		struct nap_cpu_data *d = &per_cpu(nap_data, cpu);
@@ -352,6 +362,10 @@ static ssize_t stats_show(struct kobject *kobj,
 		total_sc    += d->stats.short_circuit_count;
 		total_fpu   += d->stats.fpu_path_count;
 		total_fb    += d->stats.fallback_count;
+		total_hardirq += d->stats.simd_hardirq_count;
+		total_irqsoff += d->stats.simd_irqsoff_count;
+		total_nmi     += d->stats.simd_nmi_count;
+		total_busy    += d->stats.simd_busy_count;
 	}
 
 	len += sysfs_emit_at(buf, len, "total_selects: %llu\n", total_sel);
@@ -364,6 +378,10 @@ static ssize_t stats_show(struct kobject *kobj,
 	len += sysfs_emit_at(buf, len, "short_circuit_count: %llu\n", total_sc);
 	len += sysfs_emit_at(buf, len, "fpu_path_count: %llu\n", total_fpu);
 	len += sysfs_emit_at(buf, len, "fallback_count: %llu\n", total_fb);
+	len += sysfs_emit_at(buf, len, "simd_hardirq_count: %llu\n", total_hardirq);
+	len += sysfs_emit_at(buf, len, "simd_irqsoff_count: %llu\n", total_irqsoff);
+	len += sysfs_emit_at(buf, len, "simd_nmi_count: %llu\n", total_nmi);
+	len += sysfs_emit_at(buf, len, "simd_busy_count: %llu\n", total_busy);
 	return len;
 }
 
diff --git a/drivers/cpuidle/governors/nap/nap.h b/drivers/cpuidle/governors/nap/nap.h
index cbd336b64..d437050f5 100644
--- a/drivers/cpuidle/governors/nap/nap.h
+++ b/drivers/cpuidle/governors/nap/nap.h
@@ -190,6 +190,16 @@ struct nap_stats {
 	u64 short_circuit_count;	/* POLL short-circuit, no FPU/NN */
 	u64 fpu_path_count;		/* NN inference actually ran */
 	u64 fallback_count;		/* may_use_simd()==false or NN idx<0 */
+
+	/*
+	 * Diagnostic: breakdown of *why* may_use_simd() returned false,
+	 * checked individually when the fallback branch is taken (not
+	 * mutually exclusive -- more than one can be true at once).
+	 */
+	u64 simd_hardirq_count;
+	u64 simd_irqsoff_count;
+	u64 simd_nmi_count;
+	u64 simd_busy_count;
 };
 
 struct nap_cpu_data {
