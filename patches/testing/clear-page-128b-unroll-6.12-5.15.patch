diff --git a/arch/arm64/lib/clear_page.S b/arch/arm64/lib/clear_page.S
--- a/arch/arm64/lib/clear_page.S
+++ b/arch/arm64/lib/clear_page.S
@@ -28,11 +28,21 @@
 	b.ne	1b
 	ret
 
-2:	stnp	xzr, xzr, [x0]
+2:	/*
+	 * BACKPORT (Linux 6.12):
+	 * Unroll fallback zeroing loop to 128 bytes per iteration using 8 pairs
+	 * of non-temporal stores (STNP). Halves loop branch overhead from 64 to 32
+	 * iterations per 4KB page, maximizing memory bus saturation on ARMv8/v9 cores.
+	 */
+	stnp	xzr, xzr, [x0]
 	stnp	xzr, xzr, [x0, #16]
 	stnp	xzr, xzr, [x0, #32]
 	stnp	xzr, xzr, [x0, #48]
-	add	x0, x0, #64
+	stnp	xzr, xzr, [x0, #64]
+	stnp	xzr, xzr, [x0, #80]
+	stnp	xzr, xzr, [x0, #96]
+	stnp	xzr, xzr, [x0, #112]
+	add	x0, x0, #128
 	tst	x0, #(PAGE_SIZE - 1)
 	b.ne	2b
 	ret
