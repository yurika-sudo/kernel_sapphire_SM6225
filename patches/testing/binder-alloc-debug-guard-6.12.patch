+					   total_alloc_size, allocated_buffers,
+					   largest_alloc_size, total_free_size,
+					   free_buffers, largest_free_size);
 		}
 		binder_alloc_debug(BINDER_DEBUG_USER_ERROR,
 				   "%d: binder_alloc_buf size %zd failed, no address space\n",
 				   alloc->pid, size);
