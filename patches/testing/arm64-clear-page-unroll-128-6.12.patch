diff --git a/arch/arm64/lib/clear_page.S b/arch/arm64/lib/clear_page.S
index 1fd5d790a..0c829ada5 100644
--- a/arch/arm64/lib/clear_page.S
+++ b/arch/arm64/lib/clear_page.S
@@ -27,11 +27,21 @@ SYM_FUNC_START_PI(clear_page)
 	b.ne	1b
 	ret
 
-2:	stnp	xzr, xzr, [x0]
+2:	/*
+	 * Unroll fallback zeroing loop to 128 bytes per iteration using
+	 * 8 pairs of non-temporal stores (STNP). Halves loop branch overhead
+	 * from 64 to 32 iterations per 4KB page, saturating memory bus on
+	 * ARMv8/v9 cores during malloc, mmap, and ZRAM buffer resets.
+	 */
+	stnp	xzr, xzr, [x0]
 	stnp	xzr, xzr, [x0, #16]
 	stnp	xzr, xzr, [x0, #32]
 	stnp	xzr, xzr, [x0, #48]
-	add	x0, x0, #64
+	stnp	xzr, xzr, [x0, #64]
+	stnp	xzr, xzr, [x0, #80]
+	stnp	xzr, xzr, [x0, #96]
+	stnp	xzr, xzr, [x0, #112]
+	add	x0, x0, #128
 	tst	x0, #(PAGE_SIZE - 1)
 	b.ne	2b
 	ret
