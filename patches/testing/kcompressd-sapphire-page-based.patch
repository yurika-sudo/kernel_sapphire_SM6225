diff --git a/mm/page_io.c b/mm/page_io.c
index df9e90588..df242d3c5 100644
--- a/mm/page_io.c
+++ b/mm/page_io.c
@@ -27,2 +27,3 @@
 #include <linux/sched/task.h>
+#include <linux/kfifo.h>
 
@@ -177,2 +178,105 @@ int generic_swapfile_activate(struct swap_info_struct *sis,
 
+/*
+ * do_swapout() - Write a page to swap space (used by kcompressd)
+ * @page: The page to write out
+ *
+ * Mirrors the frontswap/synchronous fallback branches already in
+ * swap_writepage(), then drops the extra reference kcompressd_store()
+ * took when it enqueued this page.
+ */
+static void kcompressd_do_swapout(struct page *page)
+{
+	struct writeback_control wbc = {
+		.sync_mode	= WB_SYNC_NONE,
+		.nr_to_write	= SWAP_CLUSTER_MAX,
+		.range_start	= 0,
+		.range_end	= LLONG_MAX,
+		.for_reclaim	= 1,
+	};
+
+	if (frontswap_store(page) == 0) {
+		set_page_writeback(page);
+		unlock_page(page);
+		end_page_writeback(page);
+	} else {
+		__swap_writepage(page, &wbc, end_swap_bio_write);
+	}
+	put_page(page);
+}
+
+/*
+ * kcompressd_store() - Off-load page compression/writeout to kcompressd
+ * @page: The page to compress
+ *
+ * Only called from kswapd context. Gates on kcompressd being enabled
+ * and running, and on the page being anonymous. Unlike the upstream
+ * folio-based reference, this tree has no zswap_is_enabled() /
+ * mem_cgroup_zswap_writeback_enabled() to gate on -- that's fine
+ * because kcompressd_do_swapout() falls back to synchronous
+ * __swap_writepage() whenever frontswap_store() doesn't succeed.
+ */
+static bool kcompressd_store(struct page *page)
+{
+	pg_data_t *pgdat = NODE_DATA(numa_node_id());
+	unsigned int ret, sysctl_kcompressd = vm_kcompressd;
+	struct page *head = NULL;
+	unsigned long flags;
+
+	if (!current_is_kswapd())
+		return false;
+
+	if (!sysctl_kcompressd || unlikely(!pgdat->kcompressd))
+		return false;
+
+	if (!PageAnon(page))
+		return false;
+
+	/*
+	 * If the fifo is full, synchronously swap out the head page
+	 * currently queued to make room for this one.
+	 */
+	spin_lock_irqsave(&pgdat->kcompress_fifo_lock, flags);
+	if (kfifo_len(pgdat->kcompress_fifo) >= sysctl_kcompressd * sizeof(page) &&
+			unlikely(!kfifo_out(pgdat->kcompress_fifo, &head, sizeof(page)))) {
+		spin_unlock_irqrestore(&pgdat->kcompress_fifo_lock, flags);
+		return false;
+	}
+	spin_unlock_irqrestore(&pgdat->kcompress_fifo_lock, flags);
+
+	get_page(page);
+
+	ret = kfifo_in(pgdat->kcompress_fifo, &page, sizeof(page));
+	if (likely(ret))
+		wake_up_interruptible(&pgdat->kcompressd_wait);
+	else
+		put_page(page);
+
+	if (head)
+		kcompressd_do_swapout(head);
+
+	return ret;
+}
+
+/*
+ * kcompressd() - Kernel thread offloading page compression from kswapd
+ * @p: pg_data_t pointer for this node
+ */
+int kcompressd(void *p)
+{
+	pg_data_t *pgdat = (pg_data_t *)p;
+	struct page *page;
+
+	current->flags |= PF_MEMALLOC | PF_KSWAPD;
+
+	while (!kthread_should_stop()) {
+		wait_event_interruptible(pgdat->kcompressd_wait,
+				!kfifo_is_empty(pgdat->kcompress_fifo));
+
+		while (kfifo_out_locked(pgdat->kcompress_fifo,
+				&page, sizeof(page), &pgdat->kcompress_fifo_lock))
+			kcompressd_do_swapout(page);
+	}
+	return 0;
+}
