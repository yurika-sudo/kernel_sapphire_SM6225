zram: add a hack for restricting init from setting a different compression algorithm

* So we can use OUR (not ROM's) default zram comp. algo, without it being
  overriden after boot

The default compression algorithm is selected via setup-configs.sh
(CONFIG_ZRAM_DEF_COMP_ZSTDN_O). This hack only prevents userspace init
("init", "init.qcom.post_*") from overriding it at boot.

ZRAM/ZSMALLOC built-in (=y) is handled by scripts/setup-configs.sh and is
intentionally NOT part of this patch.

Ported from chickendrop89/device_xiaomi_gemstones-kernel:
  53b7d0bc73ac zram: add a hack for restricting init from setting a
               different compression algorithm

(cherry picked from commit 53b7d0bc73aca2ffff4731a45ac2bd97f3b5d9ed)
---
 drivers/block/zram/Kconfig    | 9 +++++++++
 drivers/block/zram/zram_drv.c | 6 ++++++
 2 files changed, 15 insertions(+)

diff --git a/drivers/block/zram/Kconfig b/drivers/block/zram/Kconfig
index 668c6bf2554d..5e03064e83ad 100644
--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -45,6 +45,15 @@ config ZRAM_DEF_COMP_842
 
 endchoice
 
+config ZRAM_COMP_RESTRICT_INIT
+	bool "Restrict init from setting a compression algorithm"
+	depends on ZRAM
+	help
+		This is a hack for restricting init from setting a ZRAM compression algorithm
+
+		This is so we can use different ZRAM compression algorithm without it being
+		overriden after boot completes.
+
 config ZRAM_DEF_COMP
 	string
 	default "lzo-rle" if ZRAM_DEF_COMP_LZORLE
diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index de6f15129b9d..e10a1a4a17a8 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -1002,6 +1002,12 @@ static ssize_t comp_algorithm_store(struct device *dev,
 	char compressor[ARRAY_SIZE(zram->compressor)];
 	size_t sz;
 
+	#ifdef CONFIG_ZRAM_COMP_RESTRICT_INIT
+	if (!strncmp(current->comm, "init", sizeof("init")) ||
+		!strncmp(current->comm, "init.qcom.post_", sizeof("init.qcom.post_")))
+		return len;
+	#endif
+
 	strlcpy(compressor, buf, sizeof(compressor));
 	/* ignore trailing newline */
 	sz = strlen(compressor);
-- 
