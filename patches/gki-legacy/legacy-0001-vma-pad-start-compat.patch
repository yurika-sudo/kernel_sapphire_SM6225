diff --git a/include/linux/mm.h b/include/linux/mm.h
index 1b1493f94..164f42b16 100644
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -3426,5 +3426,15 @@ void put_vma(struct vm_area_struct *vma);
 #endif	/* CONFIG_SPECULATIVE_PAGE_FAULT */
 #endif	/* CONFIG_MMU */
 
+/*
+ * sapphire: GKI-Legacy (5.15.123) has no pgsize_migration support, so a VMA
+ * has no padding region. Mirror upstream: the padding starts at vm_end.
+ * Without this the SUSFS integration fails to build with an implicit
+ * declaration of VMA_PAD_START.
+ */
+#ifndef VMA_PAD_START
+#define VMA_PAD_START(vma) ((vma)->vm_end)
+#endif
+
 #endif /* __KERNEL__ */
 #endif /* _LINUX_MM_H */
