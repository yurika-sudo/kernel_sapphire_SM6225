From: Masahito S <firelzrd@gmail.com>
Subject: [PATCH] mm/vmscan: Re-swappiness v1.3 for 5.15 MGLRU (KABI-safe)

Port of firelzrd/re-swappiness v1.3 to Linux 5.15 MGLRU.
Splits max_seq, mm_state traversal, and generation timestamps per
anon/file type so vm.swappiness works globally under MGLRU.
KABI-safe: reuses unused mm_state fields and packs u32 timestamps.
---
diff --git a/include/linux/mm_inline.h b/include/linux/mm_inline.h
index 501640b..6e56816 100644
--- a/include/linux/mm_inline.h
+++ b/include/linux/mm_inline.h
@@ -156,9 +156,21 @@ static inline int page_lru_gen(struct page *page)
 	return ((flags & LRU_GEN_MASK) >> LRU_GEN_PGOFF) - 1;
 }
 
-static inline bool lru_gen_is_active(struct lruvec *lruvec, int gen)
+static inline unsigned long lru_gen_get_max_seq(const struct lruvec *lruvec, int type)
 {
-	unsigned long max_seq = lruvec->lrugen.max_seq;
+	return type ? READ_ONCE(lruvec->mm_state.max_seq_file)
+		    : READ_ONCE(lruvec->lrugen.max_seq);
+}
+
+static inline unsigned long *lru_gen_max_seq_ptr(struct lruvec *lruvec, int type)
+{
+	return type ? &lruvec->mm_state.max_seq_file
+		    : &lruvec->lrugen.max_seq;
+}
+
+static inline bool lru_gen_is_active(struct lruvec *lruvec, int gen, int type)
+{
+	unsigned long max_seq = lru_gen_get_max_seq(lruvec, type);
 
 	VM_WARN_ON_ONCE(gen >= MAX_NR_GENS);
 
@@ -188,7 +200,7 @@ static inline void lru_gen_update_size(struct lruvec *lruvec, struct page *page,
 
 	/* addition */
 	if (old_gen < 0) {
-		if (lru_gen_is_active(lruvec, new_gen))
+		if (lru_gen_is_active(lruvec, new_gen, type))
 			lru += LRU_ACTIVE;
 		__update_lru_size(lruvec, lru, zone, delta);
 		return;
@@ -196,20 +208,20 @@ static inline void lru_gen_update_size(struct lruvec *lruvec, struct page *page,
 
 	/* deletion */
 	if (new_gen < 0) {
-		if (lru_gen_is_active(lruvec, old_gen))
+		if (lru_gen_is_active(lruvec, old_gen, type))
 			lru += LRU_ACTIVE;
 		__update_lru_size(lruvec, lru, zone, -delta);
 		return;
 	}
 
 	/* promotion */
-	if (!lru_gen_is_active(lruvec, old_gen) && lru_gen_is_active(lruvec, new_gen)) {
+	if (!lru_gen_is_active(lruvec, old_gen, type) && lru_gen_is_active(lruvec, new_gen, type)) {
 		__update_lru_size(lruvec, lru, zone, -delta);
 		__update_lru_size(lruvec, lru + LRU_ACTIVE, zone, delta);
 	}
 
 	/* demotion requires isolation, e.g., lru_deactivate_fn() */
-	VM_WARN_ON_ONCE(lru_gen_is_active(lruvec, old_gen) && !lru_gen_is_active(lruvec, new_gen));
+	VM_WARN_ON_ONCE(lru_gen_is_active(lruvec, old_gen, type) && !lru_gen_is_active(lruvec, new_gen, type));
 }
 
 static inline bool lru_gen_add_page(struct lruvec *lruvec, struct page *page, bool reclaiming)
@@ -235,7 +247,7 @@ static inline bool lru_gen_add_page(struct lruvec *lruvec, struct page *page, bo
 	 * 3. Everything else (clean, cold) is added to the oldest generation.
 	 */
 	if (PageActive(page))
-		seq = lrugen->max_seq;
+		seq = lru_gen_get_max_seq(lruvec, type);
 	else if ((type == LRU_GEN_ANON && !PageSwapCache(page)) ||
 		 (PageReclaim(page) &&
 		  (PageDirty(page) || PageWriteback(page))))
@@ -270,7 +282,7 @@ static inline bool lru_gen_del_page(struct lruvec *lruvec, struct page *page, bo
 	VM_WARN_ON_ONCE_PAGE(PageUnevictable(page), page);
 
 	/* for migrate_page_states() */
-	flags = !reclaiming && lru_gen_is_active(lruvec, gen) ? BIT(PG_active) : 0;
+	flags = !reclaiming && lru_gen_is_active(lruvec, gen, page_is_file_lru(page)) ? BIT(PG_active) : 0;
 	flags = set_mask_bits(&page->flags, LRU_GEN_MASK, flags);
 	gen = ((flags & LRU_GEN_MASK) >> LRU_GEN_PGOFF) - 1;
 
diff --git a/include/linux/mmzone.h b/include/linux/mmzone.h
index 635c141..81e9c76 100644
--- a/include/linux/mmzone.h
+++ b/include/linux/mmzone.h
@@ -387,25 +387,31 @@ enum {
 #endif
 
 /*
- * The youngest generation number is stored in max_seq for both anon and file
- * types as they are aged on an equal footing. The oldest generation numbers are
- * stored in min_seq[] separately for anon and file types as clean file pages
- * can be evicted regardless of swap constraints.
+ * The youngest generation number is stored separately for anon (max_seq) and
+ * file (mm_state.max_seq_file) so that they can be aged independently. The
+ * oldest generation numbers are stored in min_seq[] separately for anon and
+ * file types so that they can be incremented independently.
  *
- * Normally anon and file min_seq are in sync. But if swapping is constrained,
- * e.g., out of swap space, file min_seq is allowed to advance and leave anon
- * min_seq behind.
+ * KABI-safe layout: max_seq_file reuses mm_state.nr_walkers padding, and
+ * timestamps are packed as u32[ANON_AND_FILE][MAX_NR_GENS] inside timestamps[].
  *
  * The number of pages in each generation is eventually consistent and therefore
  * can be transiently negative when reset_batch_size() is pending.
  */
 struct lru_gen_struct {
-	/* the aging increments the youngest generation number */
+	/* the aging increments the youngest generation number (anon) */
 	unsigned long max_seq;
 	/* the eviction increments the oldest generation numbers */
 	unsigned long min_seq[ANON_AND_FILE];
 	/* the birth time of each generation in jiffies */
+#ifndef __GENKSYMS__
+	union {
+		unsigned long timestamps[MAX_NR_GENS];
+		u32 ts_type[ANON_AND_FILE][MAX_NR_GENS];
+	};
+#else
 	unsigned long timestamps[MAX_NR_GENS];
+#endif
 	/* the multi-gen LRU lists, lazily sorted on eviction */
 	struct list_head lists[MAX_NR_GENS][ANON_AND_FILE][MAX_NR_ZONES];
 	/* the multi-gen LRU sizes, eventually consistent */
@@ -437,20 +443,38 @@ enum {
 #define NR_BLOOM_FILTERS	2
 
 struct lru_gen_mm_state {
-	/* set to max_seq after each iteration */
+	/* set to max_seq after each iteration (anon) */
 	unsigned long seq;
-	/* where the current iteration continues after */
+	/* where the current iteration continues after (anon) */
 	struct list_head *head;
-	/* where the last iteration ended before */
+	/* where the last iteration ended before (anon) */
 	struct list_head *tail;
-	/* Unused - keep for ABI compatiiblity */
+	/* Unused - keep for ABI compatiiblity (repurposed for file aging) */
+#ifndef __GENKSYMS__
+	union {
+		struct wait_queue_head wait;
+		struct {
+			unsigned long seq_file;
+			struct list_head *head_file;
+			struct list_head *tail_file;
+		};
+	};
+#else
 	struct wait_queue_head wait;
+#endif
 	/* Bloom filters flip after each iteration */
 	unsigned long *filters[NR_BLOOM_FILTERS];
 	/* the mm stats for debugging */
 	unsigned long stats[NR_HIST_GENS][NR_MM_STATS];
-	/* Unused - keep for ABI compatiiblity */
+	/* Unused - keep for ABI compatiiblity (repurposed for file max_seq) */
+#ifndef __GENKSYMS__
+	union {
+		int nr_walkers;
+		unsigned long max_seq_file;
+	};
+#else
 	int nr_walkers;
+#endif
 };
 
 struct lru_gen_mm_walk {
@@ -460,8 +484,15 @@ struct lru_gen_mm_walk {
 	unsigned long max_seq;
 	/* the next address within an mm to scan */
 	unsigned long next_addr;
-	/* Unused -- for ABI compatibility */
+	/* Unused -- for ABI compatibility (repurposed for aging_type) */
+#ifndef __GENKSYMS__
+	union {
+		unsigned long bitmap[BITS_TO_LONGS(MIN_LRU_BATCH)];
+		int aging_type;
+	};
+#else
 	unsigned long bitmap[BITS_TO_LONGS(MIN_LRU_BATCH)];
+#endif
 	/* to batch promoted pages */
 	int nr_pages[MAX_NR_GENS][ANON_AND_FILE][MAX_NR_ZONES];
 	/* to batch the mm stats */
diff --git a/mm/vmscan.c b/mm/vmscan.c
index 3853716..0eb4636 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -3071,8 +3071,30 @@ DEFINE_STATIC_KEY_ARRAY_FALSE(lru_gen_caps, NR_LRU_GEN_CAPS);
 
 #define LRU_REFS_FLAGS	(BIT(PG_referenced) | BIT(PG_workingset))
 
+#define RESWAPPINESS_PROGNAME	"Re-swappiness: MGLRU anon/file independent aging"
+#define RESWAPPINESS_AUTHOR	"Masahito Suzuki"
+#define RESWAPPINESS_VERSION	"1.3"
+
+static inline unsigned long *mm_state_seq_ptr(struct lru_gen_mm_state *mm_state, int type)
+{
+	return type ? &mm_state->seq_file : &mm_state->seq;
+}
+
+static inline struct list_head **mm_state_head_ptr(struct lru_gen_mm_state *mm_state, int type)
+{
+	return type ? &mm_state->head_file : &mm_state->head;
+}
+
+static inline struct list_head **mm_state_tail_ptr(struct lru_gen_mm_state *mm_state, int type)
+{
+	return type ? &mm_state->tail_file : &mm_state->tail;
+}
+
 #define DEFINE_MAX_SEQ(lruvec)						\
-	unsigned long max_seq = READ_ONCE((lruvec)->lrugen.max_seq)
+	unsigned long max_seq[ANON_AND_FILE] = {			\
+		lru_gen_get_max_seq(lruvec, LRU_GEN_ANON),		\
+		lru_gen_get_max_seq(lruvec, LRU_GEN_FILE),		\
+	}
 
 #define DEFINE_MIN_SEQ(lruvec)						\
 	unsigned long min_seq[ANON_AND_FILE] = {			\
@@ -3119,15 +3141,21 @@ static int get_swappiness(struct lruvec *lruvec, struct scan_control *sc)
 
 static int get_nr_gens(struct lruvec *lruvec, int type)
 {
-	return lruvec->lrugen.max_seq - lruvec->lrugen.min_seq[type] + 1;
+	return lru_gen_get_max_seq(lruvec, type) - lruvec->lrugen.min_seq[type] + 1;
 }
 
 static bool __maybe_unused seq_is_valid(struct lruvec *lruvec)
 {
-	/* see the comment on lru_gen_struct */
-	return get_nr_gens(lruvec, LRU_GEN_FILE) >= MIN_NR_GENS &&
-	       get_nr_gens(lruvec, LRU_GEN_FILE) <= get_nr_gens(lruvec, LRU_GEN_ANON) &&
-	       get_nr_gens(lruvec, LRU_GEN_ANON) <= MAX_NR_GENS;
+	int type;
+
+	for (type = 0; type < ANON_AND_FILE; type++) {
+		int nr_gens = get_nr_gens(lruvec, type);
+
+		if (nr_gens < MIN_NR_GENS || nr_gens > MAX_NR_GENS)
+			return false;
+	}
+
+	return true;
 }
 
