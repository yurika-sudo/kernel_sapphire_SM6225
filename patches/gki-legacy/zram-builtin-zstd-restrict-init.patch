From 8174a8eed6c98372714e0049a83f9da007155eb1 Mon Sep 17 00:00:00 2001
From: yurika-sudo <yurika0uu@gmail.com>
Date: Thu, 26 Nov 2026 17:39:20 +0000
Subject: [PATCH] zram: build ZRAM and ZSMALLOC into the kernel image

- CONFIG_ZRAM=m -> y
- CONFIG_ZSMALLOC=m -> y
- CONFIG_ZRAM_DEF_COMP_ZSTD=y (better compression ratio)
- CONFIG_ZRAM_COMP_RESTRICT_INIT=y (prevent init from overriding algo)
- Remove zram.ko/zsmalloc.ko from gki_aarch64_modules and gki_system_dlkm_modules
- Remove module_implicit_outs from BUILD.bazel

Motivation: on Android 14 (legacy), modprobe for zsmalloc.ko fails at
boot (~9.4s) causing ZRAM to be torn down and re-added, with swap only
becoming active at ~70s. Building ZRAM/ZSMALLOC as built-in eliminates
the modprobe dependency and brings zram0 up during kernel init.

The ZRAM_COMP_RESTRICT_INIT hack prevents ROM/init (init.qcom.post_*)
from overriding the kernel-default compression algorithm (ZSTD), so the
kernel-chosen algo is preserved across boot.

Ported from: chickendrop89/device_xiaomi_gemstones-kernel
  812b32008c1a - module: build zsmalloc and zram into the kernel image
  53b7d0bc73ac - zram: add a hack for restricting init from setting a different compression algorithm
  3af3716cce7b - chickernel_defconfig: make ZSTD the default zram comp. algo.
  3804e8181303 - chickernel_defconfig: enable the zram (init) hack

Signed-off-by: kernel-dev <kernel@sapphire.local>
---
 BUILD.bazel                      | 8 --------
 android/gki_aarch64_modules      | 2 --
 android/gki_system_dlkm_modules  | 2 --
 arch/arm64/configs/gki_defconfig | 6 ++++--
 drivers/block/zram/Kconfig       | 9 +++++++++
 drivers/block/zram/zram_drv.c    | 6 ++++++
 6 files changed, 19 insertions(+), 14 deletions(-)

diff --git a/BUILD.bazel b/BUILD.bazel
index 44db007ca..02dad3b63 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -48,20 +48,12 @@ _aarch64_additional_kmi_symbol_lists = [
 define_common_kernels(target_configs = {
     # Sync with build.config.gki.aarch64
     "kernel_aarch64": {
-        "module_implicit_outs": [
-            "drivers/block/zram/zram.ko",
-            "mm/zsmalloc.ko",
-        ],
         "kmi_symbol_list": "android/abi_gki_aarch64",
         "additional_kmi_symbol_lists": _aarch64_additional_kmi_symbol_lists,
         "abi_definition": "android/abi_gki_aarch64.xml",
         "kmi_symbol_list_add_only": True,
     },
     "kernel_aarch64_debug": {
-        "module_implicit_outs": [
-            "drivers/block/zram/zram.ko",
-            "mm/zsmalloc.ko",
-        ],
         "kmi_symbol_list": "android/abi_gki_aarch64",
         "additional_kmi_symbol_lists": _aarch64_additional_kmi_symbol_lists,
         "abi_definition": "android/abi_gki_aarch64.xml",
diff --git a/android/gki_aarch64_modules b/android/gki_aarch64_modules
index 3d8888cbb..e69de29bb 100644
--- a/android/gki_aarch64_modules
+++ b/android/gki_aarch64_modules
@@ -1,2 +0,0 @@
-mm/zsmalloc.ko
-drivers/block/zram/zram.ko
diff --git a/android/gki_system_dlkm_modules b/android/gki_system_dlkm_modules
index 83e76f596..e69de29bb 100644
--- a/android/gki_system_dlkm_modules
+++ b/android/gki_system_dlkm_modules
@@ -1,2 +0,0 @@
-drivers/block/zram/zram.ko
-mm/zsmalloc.ko
diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 29e7bba5a..d4bd602c1 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -121,7 +121,7 @@ CONFIG_CLEANCACHE=y
 CONFIG_CMA=y
 CONFIG_CMA_DEBUGFS=y
 CONFIG_CMA_AREAS=32
-CONFIG_ZSMALLOC=m
+CONFIG_ZSMALLOC=y
 # CONFIG_ZONE_DMA is not set
 CONFIG_ANON_VMA_NAME=y
 CONFIG_LRU_GEN=y
@@ -304,7 +304,9 @@ CONFIG_ARM_SCPI_PROTOCOL=y
 # CONFIG_ARM_SCPI_POWER_DOMAIN is not set
 # CONFIG_EFI_ARMSTUB_DTB_LOADER is not set
 CONFIG_GNSS=y
-CONFIG_ZRAM=m
+CONFIG_ZRAM=y
+CONFIG_ZRAM_DEF_COMP_ZSTD=y
+CONFIG_ZRAM_COMP_RESTRICT_INIT=y
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
 CONFIG_BLK_DEV_RAM=y
diff --git a/drivers/block/zram/Kconfig b/drivers/block/zram/Kconfig
index 668c6bf25..0494f467f 100644
--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -45,6 +45,15 @@ config ZRAM_DEF_COMP_842
 
 endchoice
 
+config ZRAM_COMP_RESTRICT_INIT
+	bool "Restrict init from setting a compression algorithm"
+	depends on ZRAM
+	help
+		This is a hack for restricting init from setting a ZRAM compression algorithm
+
+		This is so we can use different ZRAM compression algorithm without it being
+		overriden after boot completes.
+
 config ZRAM_DEF_COMP
 	string
 	default "lzo-rle" if ZRAM_DEF_COMP_LZORLE
diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index 0da494afd..a740fd9d1 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -1002,6 +1002,12 @@ static ssize_t comp_algorithm_store(struct device *dev,
 	char compressor[ARRAY_SIZE(zram->compressor)];
 	size_t sz;
 
+	#ifdef CONFIG_ZRAM_COMP_RESTRICT_INIT
+	if (!strncmp(current->comm, "init", sizeof("init")) ||
+		!strncmp(current->comm, "init.qcom.post_", sizeof("init.qcom.post_")))
+		return len;
+	#endif
+
 	strlcpy(compressor, buf, sizeof(compressor));
 	/* ignore trailing newline */
 	sz = strlen(compressor);
-- 
