diff --git a/drivers/cpuidle/governors/nap/nap_fpu.c b/drivers/cpuidle/governors/nap/nap_fpu.c
index da193e084..b65ecfdb2 100644
--- a/drivers/cpuidle/governors/nap/nap_fpu.c
+++ b/drivers/cpuidle/governors/nap/nap_fpu.c
@@ -3,14 +3,13 @@
  * nap_fpu.c — FPU/SIMD code for the NAP cpuidle governor
  *
  * This file is compiled without -mgeneral-regs-only (see Makefile).
- * ALL functions here MUST be called only from within
- * kernel_neon_begin()/kernel_neon_end() blocks, guarded by
- * may_use_simd() at the call site (see nap_select() in nap.c).
+ * ALL functions here use scalar float only — no NEON/SIMD vector
