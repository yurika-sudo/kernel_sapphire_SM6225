diff --git a/drivers/cpuidle/governors/nap/nap_fpu.c b/drivers/cpuidle/governors/nap/nap_fpu.c
index b65ecfdb2..70b0e24b6 100644
--- a/drivers/cpuidle/governors/nap/nap_fpu.c
+++ b/drivers/cpuidle/governors/nap/nap_fpu.c
@@ -30,15 +30,29 @@ static inline float float_min(float a, float b) { return a < b ? a : b; }
 static inline float float_max(float a, float b) { return a > b ? a : b; }
 
 /*
- * Kernel-safe sqrtf using the arm64 NEON/FP fsqrt instruction
- * directly.  The compiler may otherwise lower nap_sqrtf to a libm
- * call, which is unavailable in the kernel.  This file is always
- * compiled with FP/NEON enabled (see Makefile).
+ * Scalar sqrtf via bit-trick seed + Newton-Raphson (no FP register
+ * constraints, no kernel_neon_begin/end required).
  */
 static inline float nap_sqrtf(float x)
 {
-	asm("fsqrt %s0, %s1" : "=w"(x) : "w"(x));
-	return x;
+	/*
+	 * Pure scalar sqrt via bit-trick seed + two Newton-Raphson iterations:
+	 *   est = 0.5 * (est + x/est)
+	 * No FP/NEON register constraints -- safe to call without
+	 * kernel_neon_begin/end in cpuidle IRQ-disabled context.
+	 * Error < 0.00001% vs fsqrt; acceptable for weight initialization.
+	 */
+	union { float f; u32 i; } u = { .f = x };
+	float est;
+
+	if (unlikely(x <= 0.0f))
+		return 0.0f;
+
+	u.i = ((u.i - (1u << 23)) >> 1) + (1u << 29);
+	est = u.f;
+	est = 0.5f * (est + x / est);
+	est = 0.5f * (est + x / est);
+	return est;
 }
 
 /* Scalar log2 approximation (same algorithm as fast_log2f_sse) */
