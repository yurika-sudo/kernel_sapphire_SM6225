  * Reflect-time updates (integer-only, no FPU needed)
  * ================================================================ */
@@ -212,8 +231,14 @@ static int nap_select(struct cpuidle_driver *drv,
 
 	d->short_circuited = false;
 
-	idx = nap_fpu_select(drv, dev, d);
-	if (idx < 0)
+	/*
+	 * Use the cached NN result from the last nap_fpu_work() run.
+	 * On the very first idle (cached_nn_idx == 0) this falls through
+	 * to nap_fallback_heuristic() which is the correct cold-start
+	 * behaviour -- identical to what upstream does with may_use_simd().
+	 */
+	idx = READ_ONCE(d->cached_nn_idx);
+	if (idx <= 0)
 		idx = nap_fallback_heuristic(drv, dev);
 
 	*stop_tick = (drv->states[idx].target_residency_ns >
@@ -269,6 +294,13 @@ static void nap_reflect(struct cpuidle_device *dev, int index)
 		d->needs_learn = true;
 	}
 
+	/*
+	 * Schedule the FPU worker to run learning + forward pass in
+	 * process context where FP/NEON registers are safe to use.
+	 * schedule_work_on() is a no-op if the work is already queued.
+	 */
+	schedule_work_on(smp_processor_id(), &d->fpu_work);
+
 	d->stats.total_residency_ns += measured_ns;
 	if (index > 0 && measured_ns < drv->states[index].target_residency_ns)
 		d->stats.overshoot_count++;
@@ -280,9 +312,11 @@ static int nap_enable(struct cpuidle_driver *drv,
 	struct nap_cpu_data *d = per_cpu_ptr(&nap_data, dev->cpu);
 
 	memset(d, 0, sizeof(*d));
+	INIT_WORK(&d->fpu_work, nap_fpu_work);
+	d->cached_nn_idx = 0;
 
 	/*
-	 * Defer weight initialization to the first nap_select() FPU path
+	 * Defer weight initialization to the first nap_fpu_work() run
 	 * via reset_pending.  nap_enable() is called from cpuidle core
 	 * (cpuidle_enable_device) which may run on a different CPU than
 	 * dev->cpu during governor switch.  Deferring ensures FPU init
@@ -311,6 +345,9 @@ static int nap_enable(struct cpuidle_driver *drv,
 static void nap_disable(struct cpuidle_driver *drv,
 			struct cpuidle_device *dev)
 {
+	struct nap_cpu_data *d = per_cpu_ptr(&nap_data, dev->cpu);
+
+	cancel_work_sync(&d->fpu_work);
 	WRITE_ONCE(nap_cached_drv, NULL);
 }
 
