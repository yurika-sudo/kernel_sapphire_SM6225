-# nap_fpu.o uses NEON/FP instructions and must have that flag removed.
-#
-# CRITICAL: nap.o is intentionally compiled with NORMAL kernel flags
-# (general-regs-only).  All floating-point/NEON code lives in nap_fpu.o,
-# which is compiled without -mgeneral-regs-only and called directly from
-# nap_select().  This separation ensures the compiler cannot emit
-# FP/NEON instructions in governor callbacks (nap_select, nap_reflect,
-# etc.) outside nap_fpu.o.
+# nap_fpu.o uses FP registers for scalar float arithmetic and must have
+# that flag removed.  It is only ever called from nap_fpu_work(), a
+# per-CPU workqueue worker that runs in process context where FP/NEON
+# registers are safe to use without kernel_neon_begin/end.
 #
 # Do NOT add a CFLAGS_REMOVE for nap.o -- it must stay general-regs-only.
 CFLAGS_REMOVE_nap_fpu.o += -mgeneral-regs-only
