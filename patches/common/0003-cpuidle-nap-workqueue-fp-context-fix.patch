diff --git a/drivers/cpuidle/governors/nap/Makefile b/drivers/cpuidle/governors/nap/Makefile
index bd4690bd2..8327f3a70 100644
--- a/drivers/cpuidle/governors/nap/Makefile
+++ b/drivers/cpuidle/governors/nap/Makefile
@@ -8,14 +8,10 @@ obj-$(CONFIG_CPU_IDLE_GOV_NAP) += cpuidle_gov_nap.o
 cpuidle_gov_nap-y := nap.o nap_fpu.o
 
