 #include <linux/sysfs.h>
 #include <linux/string.h>
 #include <linux/tick.h>
+#include <linux/workqueue.h>
 
 #include "nap.h"
 
@@ -63,6 +62,26 @@
 DEFINE_PER_CPU(struct nap_cpu_data, nap_data);
 static struct cpuidle_driver *nap_cached_drv;
 
+/* ================================================================
+ * Per-CPU FPU worker (process context -- FP/NEON safe)
+ * ================================================================ */
+
+static void nap_fpu_work(struct work_struct *work)
+{
+	struct nap_cpu_data *d =
+		container_of(work, struct nap_cpu_data, fpu_work);
+	struct cpuidle_driver *drv = READ_ONCE(nap_cached_drv);
+	struct cpuidle_device *dev = cpuidle_get_device();
+	int idx;
+
+	if (!drv || !dev)
+		return;
+
+	idx = nap_fpu_select(drv, dev, d);
+	if (idx >= 0)
+		WRITE_ONCE(d->cached_nn_idx, idx);
+}
+
