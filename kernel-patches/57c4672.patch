From 57c46727a3a4d58e1b516bed30ccb0bec944b167 Mon Sep 17 00:00:00 2001
From: chickendrop89 <chickendrop89@gmail.com>
Date: Wed, 6 Aug 2025 13:06:52 +0200
Subject: [PATCH] kernel: printk: filter IRQ debugging

* Not necessarily useful most of the time

Signed-off-by: chickendrop89 <chickendrop89@gmail.com>
---
 kernel/printk/printk.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/kernel/printk/printk.c b/kernel/printk/printk.c
index 5ace7aeb6f7a..c2f3fcc12dc7 100644
--- a/kernel/printk/printk.c
+++ b/kernel/printk/printk.c
@@ -2160,7 +2160,10 @@ __maybe_unused static bool should_filter_vendor_message(const char *text)
             "st21n", /* st21nfc  */
             "[Awin", /* [Awinic] */
 			"qpnp_", /* qpnp_vib_brightness_set */
-            NULL
+			"(virq", /* (virq:irq_count) */ 
+            "(ipi:", /* (ipi:irq_count) */
+			"(cpu:", /* (cpu:irq_count) */
+			NULL
     };
 
     for (module = filtered_modules; likely(*module); module++) {
