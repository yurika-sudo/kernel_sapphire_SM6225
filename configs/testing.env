# testing.env — loaded for build_type=testing
# Put experimental CONFIG or env changes here.
# These only activate when build_type=testing is selected.
#
# ⚠️  New CONFIGs being evaluated go here first.
#     If stable across multiple runs → promote to setup-configs.sh
#     If bootloops → document below and revert.
#
# Format: write extra lines to append to defconfig, OR set env vars.
# The file is sourced via `cat >> $GITHUB_ENV`, so use KEY=VALUE pairs.
#
# ─────────────────────────────────────────────────────
# BOOTLOOP HISTORY (do not re-add without investigation):
#   CONFIG_HZ_*                        — bootloops
#   CONFIG_PRINTK (disabled)           — bootloops
#   CONFIG_PSI (disabled)              — bootloops
#   CONFIG_PAGE_OWNER                  — bootloops
#   CONFIG_CMA_DEBUGFS                 — bootloops
#   CONFIG_UCLAMP_BUCKETS_COUNT        — bootloops
#   CONFIG_SCHED_DEBUG                 — bootloops
#   CONFIG_SCHEDSTATS                  — bootloops
#   CONFIG_IP_TABLES=y                 — bootloops
#   CONFIG_BRIDGE_NETFILTER=y          — bootloops
#   CONFIG_CGROUP_DEVICE=y             — bootloops
#   CONFIG_CFG80211=y (built-in)       — bootloops on CLO; conflicts with Qualcomm
#                                        vendor wlan.ko ABI (CNSS/FullMAC stack).
#                                        Fix: CONFIG_CFG80211=m
#   CONFIG_MAC80211=y (built-in)       — bootloops on CLO; same root cause as above.
#                                        Fix: CONFIG_MAC80211=m
#   CONFIG_USB_CONFIGFS_RNDIS/OBEX/    — recovery bootloops; these are bool configs
#     ECM_SUBSET/NCM/EEM/SERIAL/HID/    (=m == =y) and conflict with recovery USB
#     MASS_STORAGE (in NetHunter block)  gadget init sequence before Android init
#                                        is fully up. Excluded from NetHunter block.
#                                        Re-add only via KSU module if needed.
# ─────────────────────────────────────────────────────
#
# Currently testing: NetHunter CLO support
NETHUNTER=false
